<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>공부 기록</title>
    <link rel="stylesheet" href="/study.css">
</head>
<body>

<!-- 상단 네비게이션 -->
<div class="navbar">

    <div class="menu center-menu">

        <a href="/study">📘 공부기록판</a>
        <a href="/todo">✅ 할일</a>
        <a href="/post">📝 자유게시판</a>
        <a href="/notice">📢 공지사항</a>
        <a href="/myPage">👤 마이페이지</a>

    </div>

    <div class="user-menu">

        <% if (!loginUser) { %>

            <a href="/login">로그인</a>
            <a href="/register">회원가입</a>

        <% } else { %>

            <a href="/profile/<%= loginUser.user_id %>">
                <img
                    src="<%= loginUser.profile_image || '/default-profile.png' %>"
                    style="width:32px;height:32px;border-radius:50%;cursor:pointer;"
                    title="프로필 수정"
                >
            </a>

            <span><%= loginUser.nickName %>님</span>

            <a href="/logout">로그아웃</a>

        <% } %>

    </div>

</div>


<div class="container">

    <div class="header">
        <h1>📘 공부 기록 게시판</h1>
    </div>

    <% if (loginUser) { %>
    <div class="write-btn-box">
        <a href="/study/write" class="write-btn">✏ 글 작성</a>
    </div>
    <% } %>

    <hr>

    <!-- 목록 -->
    <div class="list">

        <% if (!logs || logs.length === 0) { %>
            <p class="empty">작성된 기록이 없습니다.</p>
        <% } %>

        <% logs.forEach(log => { %>

        <div class="log-box">

            <div class="top">
                <h3>
                    <a href="/study/detail/<%= log.study_log_id %>" class="title-link">
                        <%= log.title %>
                    </a>
                </h3>

                <span class="writer">
                    👤 <%= log.nickName %>
                </span>
            </div>

            <p class="content"><%= log.content %></p>

            <div class="bottom">
                <span>📂 <%= log.category %></span>
                <span>⏱ <%= log.study_time %>시간</span>
                <span><%= new Date(log.created_at).toLocaleString('ko-KR') %></span>

                <% if (loginUser && (loginUser.user_id === log.user_id || loginUser.role === 'admin')) { %>

                    <a href="/study/edit/<%= log.study_log_id %>">수정</a>

                    <a href="/study/delete/<%= log.study_log_id %>"
                       onclick="return confirm('삭제할까요?')">
                        삭제
                    </a>

                <% } %>

            </div>

        </div>

        <% }) %>

    </div>

    <hr>

    <!-- 페이지네이션 (10개 단위 블록) -->
    <div class="pagination">

        <%
        let page = currentPage || 1;
        let total = totalPages || 1;
        let blockSize = 10;

        let currentBlock = Math.ceil(page / blockSize);
        let startPage = (currentBlock - 1) * blockSize + 1;
        let endPage = startPage + blockSize - 1;

        if (endPage > total) endPage = total;
        %>

        <% if (startPage > 1) { %>
            <a href="/study?page=<%= startPage - 1 %>">‹</a>
        <% } %>

        <% for (let i = startPage; i <= endPage; i++) { %>
            <a href="/study?page=<%= i %>"
               class="<%= i === page ? 'active' : '' %>">
                <%= i %>
            </a>
        <% } %>

        <% if (endPage < total) { %>
            <a href="/study?page=<%= endPage + 1 %>">›</a>
        <% } %>

    </div>

</div>

</body>
</html>